# Copy to .env and fill in your values (never commit .env)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcs-bucket-name
DATAPROC_SA=your-dataproc-sa@your-project.iam.gserviceaccount.com

# Optional: path to GCP service-account key JSON (for local runs)
# In production, rely on Workload Identity / ADC instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
